{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Monthly English Wikipedia pageviews for the EU AI Act and Digital Services Act, live from the Wikimedia Pageviews API",

  "title": {
    "text": "Which of the EU’s new tech laws are people reading about?",
    "subtitle": [
      "Monthly views of each law’s English Wikipedia article, by people (not bots).",
      "Live from the Wikimedia Pageviews API."
    ]
  },

  "width": 600,
  "height": 380,
  "autosize": {"type": "fit", "contains": "padding"},

  "layer": [
    {
      "data": {
        "url": "https://wikimedia.org/api/rest_v1/metrics/pageviews/per-article/en.wikipedia/all-access/user/Artificial_Intelligence_Act/monthly/20160101/20301231",
        "format": {"type": "json", "property": "items"}
      },
      "transform": [
        {"calculate": "timeParse(substring(datum.timestamp, 0, 8), '%Y%m%d')", "as": "month"},
        {"calculate": "replace(datum.article, /_/g, ' ')", "as": "law"}
      ],
      "mark": {"type": "line", "strokeWidth": 2.5}
    },
    {
      "data": {
        "url": "https://wikimedia.org/api/rest_v1/metrics/pageviews/per-article/en.wikipedia/all-access/user/Digital_Services_Act/monthly/20160101/20301231",
        "format": {"type": "json", "property": "items"}
      },
      "transform": [
        {"calculate": "timeParse(substring(datum.timestamp, 0, 8), '%Y%m%d')", "as": "month"},
        {"calculate": "replace(datum.article, /_/g, ' ')", "as": "law"}
      ],
      "mark": {"type": "line", "strokeWidth": 2.5}
    }
  ],

  "encoding": {
    "x": {"field": "month", "type": "temporal", "title": null, "axis": {"format": "%Y", "grid": false}},
    "y": {"field": "views", "type": "quantitative", "title": "Monthly pageviews", "axis": {"format": "~s"}},
    "color": {"field": "law", "type": "nominal", "title": null,
              "scale": {"domain": ["Artificial Intelligence Act", "Digital Services Act"],
                        "range": ["#2B3CE0", "#E2711D"]},
              "legend": {"orient": "top", "direction": "horizontal", "labelFontSize": 12, "labelLimit": 0}},
    "tooltip": [
      {"field": "law", "title": "Article"},
      {"field": "month", "type": "temporal", "title": "Month", "format": "%B %Y"},
      {"field": "views", "title": "Pageviews", "format": ","}
    ]
  },

  "config": {
    "font": "Archivo, Helvetica Neue, Arial, sans-serif",
    "view": {"stroke": null},
    "title": {"fontSize": 19, "fontWeight": 700, "anchor": "start", "color": "#1A1F2B",
              "subtitleColor": "#5C6372", "subtitleFontSize": 13, "offset": 18},
    "axis": {"labelColor": "#5C6372", "titleColor": "#5C6372", "labelFontSize": 12,
             "titleFontSize": 12, "titleFontWeight": 500, "gridColor": "#EEF0F3",
             "domain": false, "tickColor": "#E3E5E9"},
    "legend": {"labelColor": "#1A1F2B"}
  }
}
